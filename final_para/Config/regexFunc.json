{
  "(\\w+)\\^(\\w+)": "Math.Pow($1,$2)",
  "sin\\(([^)]+)\\)": "Math.Sin($1)",
  "cos\\(([^)]+)\\)": "Math.Cos($1)",
  "tan\\(([^)]+)\\)": "Math.Tan($1)",
  "sqrt\\(([^)]+)\\)": "Math.Sqrt($1)",
  "exp\\(([^)]+)\\)": "Math.Exp($1)",
  "log\\(([^)]+)\\)": "Math.Log($1)",
  "abs\\(([^)]+)\\)": "Math.Abs($1)"
}
