{
  "(\\w+)\\^(\\w+)": "$1^{$2}",
  "sqrt\\(([^)]+)\\)": "\\sqrt{$1}",
  "sin\\(([^)]+)\\)": "\\sin($1)",
  "cos\\(([^)]+)\\)": "\\cos($1)",
  "tan\\(([^)]+)\\)": "\\tan($1)",
  "exp\\(([^)]+)\\)": "e^{$1}",
  "log\\(([^)]+)\\)": "\\ln($1)",
  "abs\\(([^)]+)\\)": "\\left|$1\\right|",
  "pi": "\\pi",
  "∞": "\\infty"
}
